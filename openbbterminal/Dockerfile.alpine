#FROM python:3.14.0-slim-trixie@sha256:9dc4ef3e628432af2237d1418908f5c6d4528e9f776aaa6e7c95c18854c86e48
FROM alpine:edge@sha256:020dfcbaaf4cc1078bf2d9c7ba31a8466e334061dcd2f248001d68f79e52c000
#FROM python:3.14.0-alpine3.22@sha256:0bf59161c735f604ea070af402d65b1a088ce3fd7fe4329f5983446148e84930

ARG BUILD_VERSION

#ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
	UV_NO_CACHE=1 \
	UV_LINK_MODE=copy \
	UV_PYTHON_DOWNLOADS=never

# requirements.txt now generated from Pipfile
# pipenv lock -r > requirements.txt
COPY pyproject.toml uv.lock ./

RUN apk update && \
	apk upgrade -a && \
	# NOTE: still incomplete. pywry -> pytauri-wheel -> glib-sys needs the full
	# GTK/WebKit native stack (glib-dev gtk+3.0-dev webkit2gtk-dev libsoup-dev),
	# because there is no musl wheel for pywry. Use the Ubuntu Dockerfile, which
	# gets pywry from a manylinux wheel.
	build_pkgs="build-base cargo cmake gfortran git openssl-dev python3-dev rust uv" && \
	runtime_pkgs="ca-certificates openssl python3" && \
  apk --no-cache add --virtual build-dependencies ${build_pkgs} && \
  apk --no-cache add ${runtime_pkgs} && \
	uv sync --frozen --no-install-project --no-dev --python /usr/bin/python3 && \
	apk del build-dependencies && \
	rm -rf /var/cache/apk/* && \
  find /usr/lib/ -name '__pycache__' -print0 | xargs -0 -n1 rm -rf && \
  find /usr/lib/ -name '*.pyc' -print0 | xargs -0 -n1 rm -rf && \
  rm -rf /root/.cargo

ENV PATH="/opt/venv/bin:${PATH}"

LABEL org.opencontainers.image.authors="Jauder Ho <jauderho@users.noreply.github.com>"
LABEL org.opencontainers.image.url="https://github.com/jauderho/dockerfiles"
LABEL org.opencontainers.image.documentation="https://github.com/jauderho/dockerfiles"
LABEL org.opencontainers.image.source="https://github.com/jauderho/dockerfiles"
LABEL org.opencontainers.image.title="jauderho/openbbterminal"
LABEL org.opencontainers.image.description="OpenBBTerminal is an awesome stock and crypto market terminal"

ENTRYPOINT ["openbb"]
#CMD ["-h"]
